{
  "name": "@autonome-research/thread-phase-cli",
  "version": "2.3.0",
  "description": "CLI and auto-loader for thread-phase — discovers extensions under .thread-phase/ and runs registered pipelines.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "thread-phase": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('./dist/bin.js', 0o755)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@autonome-research/thread-phase": "^2.3.0"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@autonome-research/thread-phase": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Code4me2/thread-phase.git",
    "directory": "packages/thread-phase-cli"
  }
}
